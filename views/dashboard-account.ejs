<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <div class="layout">
    <%- include('partials/sidebar', { active: 'account' }) %>

    <main class="content">
      <h1><%= t('account.title') %></h1>

      <div class="card">
        <p><%= t('account.email_label') %><strong><%= account.email %></strong></p>
      </div>

      <div class="card">
        <h2><%= t('account.change_password_title') %></h2>
        <% if (message) { %><p class="success"><%= t(message) %></p><% } %>
        <% if (error) { %><p class="error"><%= t(error) %></p><% } %>
        <form method="POST" action="/dashboard/account/password">
          <label><%= t('account.current_password') %>
            <input type="password" name="currentPassword" required>
          </label>
          <label><%= t('account.new_password') %>
            <input type="password" name="newPassword" required minlength="8">
          </label>
          <button type="submit" class="button"><%= t('account.update_button') %></button>
        </form>
      </div>
    </main>
  </div>
</body>
</html>
