<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <div class="layout">
    <%- include('partials/sidebar', { active: 'account' }) %>

    <main class="content">
      <h1><%= t('account.title') %></h1>

      <div class="card">
        <p><%= t('account.email_label') %><strong><%= account.email %></strong></p>
      </div>

      <div class="card">
        <h2><%= t('account.notify_title') %></h2>
        <p><%= t('account.notify_intro') %></p>
        <% if (typeof notifyMessage !== 'undefined' && notifyMessage) { %><p class="success"><%= t(notifyMessage) %></p><% } %>
        <% if (typeof notifyError !== 'undefined' && notifyError) { %><p class="error"><%= t(notifyError) %></p><% } %>
        <form method="POST" action="/dashboard/account/notify-email">
          <label><%= t('account.notify_label') %>
            <input type="email" name="notifyEmail" maxlength="200" value="<%= account.lead_notify_email || '' %>" placeholder="<%= account.email %>">
          </label>
          <button type="submit" class="button"><%= t('account.update_button') %></button>
        </form>
      </div>

      <div class="card">
        <h2><%= t('account.change_password_title') %></h2>
        <% if (message) { %><p class="success"><%= t(message) %></p><% } %>
        <% if (error) { %><p class="error"><%= t(error) %></p><% } %>
        <form method="POST" action="/dashboard/account/password">
          <label><%= t('account.current_password') %>
            <input type="password" name="currentPassword" required>
          </label>
          <label><%= t('account.new_password') %>
            <input type="password" name="newPassword" required minlength="8">
          </label>
          <button type="submit" class="button"><%= t('account.update_button') %></button>
        </form>
      </div>

      <div class="card card-danger">
        <h2><%= t('account.delete_title') %></h2>
        <p><%= t('account.delete_text') %></p>
        <% if (typeof deleteError !== 'undefined' && deleteError) { %><p class="error"><%= t(deleteError) %></p><% } %>
        <form method="POST" action="/dashboard/account/delete">
          <label><%= t('account.current_password') %>
            <input type="password" name="password" required>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="confirm" value="yes" required>
            <%= t('account.delete_confirm_label') %>
          </label>
          <button type="submit" class="button button-danger"><%= t('account.delete_button') %></button>
        </form>
      </div>
    </main>
  </div>
</body>
</html>
