<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
  <meta name="description" content="<%= t('home.meta_description') %>">
  <meta property="og:title" content="NovIA — <%= t('site.tagline') %>">
  <meta property="og:description" content="<%= t('home.meta_description') %>">
  <meta property="og:image" content="https://novia.help/images/capybara-logo.png">
  <meta property="og:url" content="https://novia.help/">
</head>
<body class="home">
  <% if (accountDeleted) { %><p class="account-deleted-notice"><%= t('account.deleted_notice') %></p><% } %>
  <header class="home-header">
    <a href="/" class="home-brand">
      <img src="/images/capybara-logo-192.png" alt="" class="home-brand-logo">
      NovIA
    </a>
    <nav class="home-nav">
      <div class="lang-switch">
        <a href="?lang=fr" class="<%= lang === 'fr' ? 'active' : '' %>">FR</a>
        <a href="?lang=en" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
      </div>
      <a href="/login" class="home-nav-link"><%= t('home.nav_login') %></a>
    </nav>
  </header>

  <main class="home-main">
    <section class="home-pitch">
      <p class="home-hero-tagline"><%= t('site.tagline') %></p>
      <h1><%= t('pitch.title') %></h1>
      <p class="home-hero-sub"><%= t('home.hero_sub') %></p>
      <ul class="home-points">
        <% [1, 2, 3].forEach(function(n) { %>
          <li><%= t('home.point' + n) %></li>
        <% }); %>
      </ul>
      <div class="home-hero-actions">
        <a href="/demo" class="button button-accent button-large"><%= t('home.cta_demo') %></a>
        <a href="/register" class="button button-ghost button-large"><%= t('home.cta_register') %></a>
      </div>
      <p class="home-hero-hint"><%= t('pitch.demo_hint') %></p>
    </section>

    <section class="home-pricing" id="forfaits">
      <h2><%= t('home.pricing_title') %></h2>
      <p class="home-pricing-sub"><%= t('home.pricing_sub') %></p>
      <ul class="home-plan-list">
        <% plans.forEach(function(plan) { %>
          <li class="home-plan <%= plan.key === 'pro' ? 'home-plan-featured' : '' %>">
            <div>
              <strong><%= t('plan.' + plan.key + '.name') %></strong>
              <% if (plan.key === 'pro') { %><span class="badge"><%= t('home.plan_popular') %></span><% } %>
              <span class="home-plan-detail">≈ <%= plan.approxReplies.toLocaleString(lang === 'en' ? 'en-US' : 'fr-CA') %> <%= t('home.replies_per_month') %><% if (plan.allowCustomBranding) { %> · <%= t('home.plan_branding') %><% } %></span>
            </div>
            <span class="home-plan-price"><%= (plan.priceCents / 100).toFixed(2) %><%= t('billing.per_month') %></span>
          </li>
        <% }); %>
      </ul>
      <a href="/register" class="button home-pricing-cta"><%= t('home.cta_register') %></a>
      <p class="home-pricing-note"><%= t('home.pricing_note') %></p>
    </section>
  </main>

  <section class="home-steps">
    <% [1, 2, 3].forEach(function(n) { %>
      <div class="home-step">
        <span class="home-step-number"><%= n %></span>
        <div>
          <h3><%= t('home.step' + n + '_title') %></h3>
          <p><%= t('home.step' + n + '_text') %></p>
        </div>
      </div>
    <% }); %>
  </section>

  <% if (showcaseSites.length > 0) { %>
    <section class="home-showcase">
      <h2><%= t('home.showcase_title') %></h2>
      <p><%= t('home.showcase_sub') %></p>
      <ul>
        <% showcaseSites.forEach(function(site) { %>
          <li><a href="<%= site.url %>" target="_blank" rel="noopener"><%= site.name %> ↗</a></li>
        <% }); %>
      </ul>
    </section>
  <% } %>

  <footer class="home-footer">
    <span>© <%= new Date().getFullYear() %> NovIA — <%= t('site.tagline') %></span>
    <span class="home-footer-links">
      <a href="/conditions"><%= t('terms.link') %></a>
      <a href="/confidentialite"><%= t('privacy.link') %></a>
      <a href="/login"><%= t('home.nav_login') %></a>
    </span>
  </footer>

  <script src="/widget.js" data-client="novia-demo" async></script>
</body>
</html>
