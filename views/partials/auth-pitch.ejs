<div class="site-brand">
  NovIA
  <span class="site-tagline"><%= t('site.tagline') %></span>
</div>

<div class="auth-pitch">
  <div class="pitch-chat">
    <img src="/images/capybara-logo.png" alt="NovIA" class="pitch-chat-avatar">
    <div class="pitch-chat-bubbles">
      <div class="pitch-bubble pitch-bubble-quote"><%= t('pitch.quote') %></div>
      <div class="pitch-bubble pitch-bubble-title"><%= t('pitch.title') %></div>
      <div class="pitch-bubble"><%= t('pitch.item1') %></div>
      <div class="pitch-bubble"><%= t('pitch.item2') %></div>
      <div class="pitch-bubble"><%= t('pitch.item3') %></div>
      <div class="pitch-bubble"><%= t('pitch.item4') %></div>
      <div class="pitch-bubble"><%= t('pitch.item5') %></div>
    </div>
  </div>

  <p class="auth-pitch-demo-hint"><%= t('pitch.demo_hint') %></p>
  <p class="auth-pitch-demo-hint"><a href="/demo"><%= t('demo.pitch_cta') %></a></p>
</div>

<script src="/widget.js" data-client="novia-demo" async></script>
