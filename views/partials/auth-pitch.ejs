<div class="auth-pitch">
  <img src="/images/capybara-logo.png" alt="NovIA" class="auth-pitch-logo">

  <div class="auth-pitch-bubble">
    <p class="auth-pitch-quote"><%= t('pitch.quote') %></p>
  </div>

  <h2 class="auth-pitch-title"><%= t('pitch.title') %></h2>

  <ul class="auth-pitch-list">
    <li><%= t('pitch.item1') %></li>
    <li><%= t('pitch.item2') %></li>
    <li><%= t('pitch.item3') %></li>
    <li><%= t('pitch.item4') %></li>
    <li><%= t('pitch.item5') %></li>
  </ul>

  <p class="auth-pitch-demo-hint"><%= t('pitch.demo_hint') %></p>
</div>

<script src="/widget.js" data-client="novia-demo" async></script>
