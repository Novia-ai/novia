<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <div class="layout">
    <%- include('partials/sidebar', { active: 'billing' }) %>

    <main class="content">
      <h1><%= t('billing.title') %></h1>

      <% if (error) { %>
        <p class="error"><%= t('billing.error_prefix') %><%= error %><%= t('billing.error_suffix') %></p>
      <% } %>

      <div class="card">
        <h2><%= t('billing.plans_title') %></h2>
        <div class="plan-grid">
          <% plans.forEach(function(plan) { %>
            <div class="plan-card <%= account && account.plan_key === plan.key ? 'plan-card-active' : '' %>">
              <h3><%= t('plan.' + plan.key + '.name') %></h3>
              <p class="plan-price"><%= (plan.price_cents / 100).toFixed(2) %><%= t('billing.per_month') %></p>
              <p><%= plan.monthly_token_limit.toLocaleString(lang === 'en' ? 'en-US' : 'fr-CA') %> <%= t('billing.tokens_per_month') %></p>
              <p><%= plan.allow_custom_branding ? t('billing.branding_yes') : t('billing.branding_no') %></p>
              <% if (account && account.plan_key === plan.key) { %>
                <span class="badge"><%= t('billing.current_plan_badge') %></span>
              <% } else { %>
                <form method="POST" action="/dashboard/billing/checkout/<%= plan.key %>">
                  <button type="submit" class="button"><%= t('common.choose') %></button>
                </form>
              <% } %>
            </div>
          <% }); %>
        </div>
      </div>

      <% if (account && account.subscription_id) { %>
        <div class="card">
          <h2><%= t('billing.autopay_title') %></h2>
          <p><%= t('billing.autopay_current') %><strong><%= account.autopay ? t('billing.autopay_active') : t('billing.autopay_inactive') %></strong></p>
          <form method="POST" action="/dashboard/billing/autopay">
            <input type="hidden" name="autopay" value="<%= account.autopay ? 'false' : 'true' %>">
            <button type="submit" class="button"><%= account.autopay ? t('billing.autopay_disable') : t('billing.autopay_enable') %></button>
          </form>
        </div>
      <% } %>

      <div class="card">
        <h2><%= t('billing.packs_title') %></h2>
        <div class="plan-grid">
          <% tokenPacks.forEach(function(pack) { %>
            <div class="plan-card">
              <h3><%= pack.name %></h3>
              <p class="plan-price"><%= (pack.price_cents / 100).toFixed(2) %>$</p>
              <p><%= pack.token_amount.toLocaleString(lang === 'en' ? 'en-US' : 'fr-CA') %> tokens</p>
              <form method="POST" action="/dashboard/billing/token-pack/<%= pack.key %>">
                <button type="submit" class="button"><%= t('common.buy') %></button>
              </form>
            </div>
          <% }); %>
        </div>
      </div>

      <div class="card">
        <h2><%= t('billing.history_title') %></h2>
        <% if (purchases.length === 0) { %>
          <p><%= t('billing.history_empty') %></p>
        <% } else { %>
          <ul>
            <% purchases.forEach(function(p) { %>
              <li><%= new Date(p.created_at).toLocaleDateString(lang === 'en' ? 'en-US' : 'fr-CA') %> — <%= p.pack_name %> (+<%= p.tokens_granted %> tokens)</li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </main>
  </div>
</body>
</html>
