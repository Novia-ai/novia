<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <div class="layout">
    <%- include('partials/sidebar', { active: 'overview' }) %>

    <main class="content">
      <h1><%= t('dashboard.title') %></h1>

      <% if (account && account.plan_name) { %>
        <div class="card">
          <h2><%= t('dashboard.current_plan') %><%= t('plan.' + account.plan_key + '.name') %></h2>
          <p><%= t('dashboard.status') %><%= account.status %></p>
          <p><%= t('dashboard.tokens_used') %><%= account.tokens_used_current_period %> / <%= account.monthly_token_limit %></p>
          <p><%= t('dashboard.bonus_balance') %><%= account.bonus_token_balance %></p>
          <p>
            <%= t('dashboard.renewal') %>
            <%= account.current_period_end ? new Date(account.current_period_end).toLocaleDateString(lang === 'en' ? 'en-US' : 'fr-CA') : '-' %>
            (<%= account.autopay ? t('dashboard.autopay_on') : t('dashboard.autopay_off') %>)
          </p>
        </div>
      <% } else { %>
        <div class="card">
          <p><%= t('dashboard.no_plan') %></p>
          <a href="/dashboard/billing" class="button"><%= t('dashboard.choose_plan') %></a>
        </div>
      <% } %>

      <div class="card">
        <h2><%= t('dashboard.integration_title') %></h2>
        <p>
          <%= t('dashboard.integration_text') %>
        </p>
      </div>
    </main>
  </div>
</body>
</html>
