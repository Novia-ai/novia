PORT=3002
NODE_ENV=development
APP_BASE_URL=http://localhost:3002

DATABASE_URL=postgresql://novia:novia@localhost:5432/novia

SESSION_SECRET=change-me-to-a-long-random-string

# Compte de demonstration affiche sur la page de login (widget "novia-demo")
# Laisser vide pour desactiver la creation de ce compte au demarrage.
DEMO_ACCOUNT_EMAIL=demo@novia.help
DEMO_ACCOUNT_PASSWORD=change-me

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs (Dashboard Stripe > Produits) - un prix recurrent par forfait
STRIPE_PRICE_BASE=
STRIPE_PRICE_BASE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Stripe Price IDs pour les packs de tokens (prix ponctuels)
STRIPE_PRICE_PACK_SMALL=
STRIPE_PRICE_PACK_MEDIUM=
STRIPE_PRICE_PACK_LARGE=
